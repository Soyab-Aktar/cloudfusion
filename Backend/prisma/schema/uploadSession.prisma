model UploadSession {
  id              String       @id @default(uuid())
  userId          String
  fileName        String
  mimeType        String
  size            BigInt
  targetAccountId String
  folderId        String?
  status          UploadStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [targetAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("upload_sessions")
}
